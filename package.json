{
  "name": "atlas-cuerpo-humano",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Atlas 3D interactivo del cuerpo humano — proyecto personal de estudio de anatomía y fisiología.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "modelos:descargar": "node scripts/descargar-bodyparts3d.mjs",
    "modelos": "node scripts/construir-modelos.mjs",
    "modelos:inspeccionar": "gltf-transform inspect public/models/esqueletico.glb"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "fuse.js": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.170.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "adm-zip": "^0.5.18",
    "jsdom": "^25.0.1",
    "meshoptimizer": "^1.3.0",
    "obj2gltf": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
